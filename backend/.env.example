# Banco de dados
DATABASE_URL=postgresql+asyncpg://painel:painel@db:5432/painel_cotacoes

# Autenticação — GERE uma chave própria em produção, ex: `openssl rand -hex 32`
JWT_SECRET_KEY=troque-esta-chave-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Limite de telas simultâneas
DEFAULT_MAX_SESSIONS=1
# reject: recusa novo login se o limite foi atingido
# kick_oldest: derruba a sessão mais antiga automaticamente para liberar espaço
SESSION_LIMIT_POLICY=reject
SESSION_IDLE_TIMEOUT_MINUTES=5

# Atualização de cotações
QUOTE_POLL_INTERVAL_SECONDS=5
DOLAR_API_URL=https://economia.awesomeapi.com.br/json/last/USD-BRL
CAFE_YAHOO_SYMBOL=KC=F

# CORS (separe múltiplas origens por vírgula se necessário, ajuste o formato em config.py)
CORS_ORIGINS=["http://localhost:8000"]
